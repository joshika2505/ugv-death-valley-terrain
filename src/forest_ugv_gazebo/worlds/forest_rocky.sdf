<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="forest_rocky">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 35 0.5 0.3 0.2</pose><diffuse>0.9 0.88 0.8 1</diffuse><direction>-0.4 0.2 -1</direction></light>
    <scene><ambient>0.58 0.62 0.58 1</ambient><background>0.5 0.7 0.9 1</background><shadows>true</shadows></scene>

    <model name="ground"><static>true</static><link name="l"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry><material><ambient>0.20 0.35 0.16 1</ambient><diffuse>0.25 0.40 0.20 1</diffuse></material></visual></link></model>

    <!-- Trail -->
    <model name="trail_1"><static>true</static><pose>5.0 0.0 0.002 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>10.5 2.4 0.004</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.52 0.35 1</diffuse></material></visual></link></model>
    <model name="trail_2"><static>true</static><pose>15.0 1.5 0.002 0 0 0.2</pose><link name="l"><visual name="v"><geometry><box><size>10.5 2.4 0.004</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.52 0.35 1</diffuse></material></visual></link></model>

    <model name="point_a"><static>true</static><pose>0 0 0.006 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>1.1</radius><length>0.01</length></cylinder></geometry><material><ambient>0.2 0.5 0.9 1</ambient><diffuse>0.2 0.5 0.9 1</diffuse></material></visual></link></model>
    <model name="point_b"><static>true</static><pose>20 3.0 0.006 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>1.3</radius><length>0.01</length></cylinder></geometry><material><ambient>0.2 0.85 0.4 1</ambient><diffuse>0.2 0.85 0.4 1</diffuse></material></visual></link></model>

    <!-- Multiple Obstacle Rocks & Boulder Formations -->
    <model name="rock_1"><static>true</static><pose>5.5 0.5 0.35 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.8 0.7 0.6</size></box></geometry><material><ambient>0.4 0.38 0.36 1</ambient><diffuse>0.5 0.48 0.45 1</diffuse></material></visual><collision name="c"><geometry><box><size>0.8 0.7 0.6</size></box></geometry></collision></link></model>
    <model name="rock_2"><static>true</static><pose>10.5 -0.3 0.4 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>0.45</radius></sphere></geometry><material><ambient>0.4 0.38 0.36 1</ambient><diffuse>0.5 0.48 0.45 1</diffuse></material></visual><collision name="c"><geometry><sphere><radius>0.45</radius></sphere></geometry></collision></link></model>
    <model name="rock_3"><static>true</static><pose>15.2 2.2 0.38 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.9 0.8 0.65</size></box></geometry><material><ambient>0.4 0.38 0.36 1</ambient><diffuse>0.5 0.48 0.45 1</diffuse></material></visual><collision name="c"><geometry><box><size>0.9 0.8 0.65</size></box></geometry></collision></link></model>
  </world>
</sdf>
