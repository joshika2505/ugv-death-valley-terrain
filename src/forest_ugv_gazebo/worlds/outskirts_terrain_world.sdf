    </model>

    <model name="granite_boulder_2">
      <static>true</static>
      <pose>9.2 6.8 0.50 0 0 -0.6</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.4 1.1 1.0</size></box></geometry></collision>
        <visual name="vis">
