    <!-- Natural Granite Boulders -->
    <model name="granite_boulder_1">
      <static>true</static>
      <pose>14.5 5.5 0.45 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.9 0.9</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.9 0.9</size></box></geometry>
          <material><ambient>0.40 0.42 0.44 1.0</ambient><diffuse>0.46 0.48 0.50 1.0</diffuse></material>
        </visual>
