    <!-- Outskirts Perimeter Fences & Walls -->
    <model name="perimeter_fence_north">
      <static>true</static>
      <pose>12.0 14.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>28.0 0.3 1.5</size></box></geometry></collision>
        <visual name="vis">
