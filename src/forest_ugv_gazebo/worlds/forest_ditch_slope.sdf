<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="forest_ditch_slope">
    <physics name="1ms" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 35 0.5 0.3 0.2</pose><diffuse>0.88 0.86 0.78 1</diffuse><direction>-0.45 0.25 -1</direction></light>
    <scene><ambient>0.55 0.62 0.58 1</ambient><background>0.48 0.68 0.85 1</background><shadows>true</shadows></scene>

    <model name="ground"><static>true</static><link name="l"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry><material><ambient>0.18 0.32 0.14 1</ambient><diffuse>0.22 0.38 0.18 1</diffuse></material></visual></link></model>

    <!-- Trail -->
    <model name="trail"><static>true</static><pose>10.0 1.0 0.002 0 0 0.1</pose><link name="l"><visual name="v"><geometry><box><size>22.0 2.4 0.004</size></box></geometry><material><ambient>0.52 0.40 0.26 1</ambient><diffuse>0.62 0.48 0.32 1</diffuse></material></visual></link></model>

    <model name="point_a"><static>true</static><pose>0 0 0.006 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>1.1</radius><length>0.01</length></cylinder></geometry><material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.2 0.55 0.95 1</diffuse></material></visual></link></model>
    <model name="point_b"><static>true</static><pose>20 2.5 0.006 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>1.3</radius><length>0.01</length></cylinder></geometry><material><ambient>0.15 0.8 0.35 1</ambient><diffuse>0.25 0.9 0.45 1</diffuse></material></visual></link></model>

    <!-- Dangerous Ditch / Depression trench on the right -->
    <model name="ditch_right">
      <static>true</static>
      <pose>8.0 -1.8 0.15 0 0 0.1</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>12.0 1.6 0.3</size></box></geometry><material><ambient>0.15 0.10 0.05 1</ambient><diffuse>0.22 0.15 0.08 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>12.0 1.6 0.3</size></box></geometry></collision>
      </link>
    </model>

    <!-- Elevated Slope Hazard on the left -->
    <model name="slope_left">
      <static>true</static>
      <pose>12.0 3.6 0.35 0.2 0 0.1</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>10.0 2.5 0.7</size></box></geometry><material><ambient>0.25 0.35 0.2 1</ambient><diffuse>0.3 0.42 0.22 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>10.0 2.5 0.7</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
