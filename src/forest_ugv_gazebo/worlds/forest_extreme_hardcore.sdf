<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="forest_extreme_hardcore">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- High-Contrast Sunlight & Forest Canopy Shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>10 15 30 0 0 0</pose>
      <diffuse>0.85 0.82 0.75 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- Ground Plane: Forest Floor Terrain -->
    <model name="forest_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 80</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.28 0.16 1</ambient>
            <diffuse>0.22 0.32 0.18 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dirt Trail Ribbon Visual -->
    <model name="dirt_trail">
      <static>true</static>
      <link name="trail_link">
        <pose>10 1.75 0.005 0 0 0.17</pose>
        <visual name="trail_visual">
          <geometry>
            <box><size>25 2.2 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.42 0.32 0.20 1</ambient>
            <diffuse>0.48 0.36 0.24 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== EXTREME OBSTACLES: FALLEN TREE BARRICADES ==================== -->
    
    <!-- Fallen Tree 1 (x=5.5m, y=0.8m) - Angled Barricade forcing right shoulder maneuver -->
    <model name="fallen_tree_barricade_1">
      <static>true</static>
      <link name="log_link">
        <pose>5.5 0.8 0.35 0.12 1.57 0.85</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.26</radius><length>3.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.26</radius><length>3.6</length></cylinder></geometry>
          <material>
            <ambient>0.30 0.18 0.10 1</ambient>
            <diffuse>0.35 0.22 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fallen Tree 2 (x=9.5m, y=1.6m) - Heavy Trunk blocking left-central trail -->
    <model name="fallen_tree_barricade_2">
      <static>true</static>
      <link name="log_link">
        <pose>9.5 1.6 0.38 0.15 1.57 0.45</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>3.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>3.6</length></cylinder></geometry>
          <material>
            <ambient>0.28 0.16 0.08 1</ambient>
            <diffuse>0.32 0.20 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fallen Tree 3 (x=14.0m, y=1.0m) - Double Log Barrier forcing left bypass -->
    <model name="fallen_tree_barricade_3">
      <static>true</static>
      <link name="log_link">
        <pose>14.0 1.0 0.36 0 1.57 1.10</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.26</radius><length>3.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.26</radius><length>3.6</length></cylinder></geometry>
          <material>
            <ambient>0.32 0.20 0.12 1</ambient>
            <diffuse>0.38 0.24 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fallen Tree 4 (x=17.5m, y=3.8m) - Goal Approach Barricade -->
    <model name="fallen_tree_barricade_4">
      <static>true</static>
      <link name="log_link">
        <pose>17.5 3.8 0.35 0.1 1.57 0.65</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.26</radius><length>3.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.26</radius><length>3.2</length></cylinder></geometry>
          <material>
            <ambient>0.26 0.15 0.08 1</ambient>
            <diffuse>0.30 0.18 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== EXTREME OBSTACLES: BOULDER FIELDS ==================== -->

    <!-- Boulder Cluster A (x=7.5m, y=-0.8m) -->
    <model name="boulder_field_1">
      <static>true</static>
      <link name="rock_link">
        <pose>7.5 -0.8 0.55 0.2 0.1 0.5</pose>
        <collision name="collision">
          <geometry><box><size>1.2 1.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.1 1.0</size></box></geometry>
          <material>
            <ambient>0.40 0.42 0.45 1</ambient>
            <diffuse>0.48 0.50 0.52 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boulder Cluster B (x=10.2m, y=2.2m) - Primary Boulder Trap -->
    <model name="boulder_field_2">
      <static>true</static>
      <link name="rock_link">
        <pose>10.2 2.2 0.65 0.3 0.2 1.1</pose>
        <collision name="collision">
          <geometry><box><size>1.3 1.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.3 1.2 1.2</size></box></geometry>
          <material>
            <ambient>0.35 0.38 0.40 1</ambient>
            <diffuse>0.42 0.45 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boulder Cluster C (x=12.0m, y=-1.0m) -->
    <model name="boulder_field_3">
      <static>true</static>
      <link name="rock_link">
        <pose>12.0 -1.0 0.60 0.1 0.4 0.8</pose>
        <collision name="collision">
          <geometry><box><size>1.2 1.2 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 1.1</size></box></geometry>
          <material>
            <ambient>0.38 0.40 0.42 1</ambient>
            <diffuse>0.45 0.48 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boulder Cluster D (x=16.0m, y=1.2m) -->
    <model name="boulder_field_4">
      <static>true</static>
      <link name="rock_link">
        <pose>16.0 1.2 0.65 0.2 0.3 0.4</pose>
        <collision name="collision">
          <geometry><box><size>1.2 1.1 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.1 1.1</size></box></geometry>
          <material>
            <ambient>0.36 0.38 0.42 1</ambient>
            <diffuse>0.44 0.46 0.49 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== RAVINE & DITCH HAZARDS ==================== -->
    
    <!-- Left Shoulder Trench (x=11.5m, y=-2.2m) -->
    <model name="trench_left_shoulder">
      <static>true</static>
      <link name="trench_link">
        <pose>11.5 -2.2 0.25 0 0 0.15</pose>
        <collision name="collision">
          <geometry><box><size>12.0 1.8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.0 1.8 0.5</size></box></geometry>
          <material>
            <ambient>0.20 0.14 0.08 1</ambient>
            <diffuse>0.24 0.16 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== DENSE PINE TREE CLUSTERS ==================== -->
    <model name="dense_pine_1"><static>true</static><link name="l"><pose>3.0 -2.5 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>
    <model name="dense_pine_2"><static>true</static><link name="l"><pose>4.5 3.2 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>
    <model name="dense_pine_3"><static>true</static><link name="l"><pose>8.0 -3.0 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>
    <model name="dense_pine_4"><static>true</static><link name="l"><pose>11.0 4.8 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>
    <model name="dense_pine_5"><static>true</static><link name="l"><pose>13.5 -2.8 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>
    <model name="dense_pine_6"><static>true</static><link name="l"><pose>16.5 5.2 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>
    <model name="dense_pine_7"><static>true</static><link name="l"><pose>19.0 -2.5 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>
    <model name="dense_pine_8"><static>true</static><link name="l"><pose>21.5 5.5 3.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6.0</length></cylinder></geometry><material><ambient>0.12 0.38 0.14 1</ambient></material></visual></link></model>

    <!-- Point B Goal Marker (x=20.0m, y=3.5m) -->
    <model name="goal_point_b_beacon">
      <static>true</static>
      <link name="beacon_link">
        <pose>20.0 3.5 1.5 0 0 0</pose>
        <visual name="beacon_visual">
          <geometry><cylinder><radius>0.35</radius><length>3.0</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.9 1.0 0.7</ambient>
            <diffuse>0.0 0.9 1.0 0.7</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
