<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="real_digital_twin_world">
    <!-- ==================== High-Precision PhysX/ODE Physics Profile ==================== -->
    <physics name="1ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ==================== Core Simulation Plugins ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- GUI Follow-Camera Tracking MARBLE Husky UGV -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.0 -7.0 7.0 0 0.60 0.90</pose>
        <view_controller>orbit</view_controller>
        <track>
          <target>forest_ugv</target>
          <min_dist>3.5</min_dist>
          <max_dist>15.0</max_dist>
        </track>
      </camera>
    </gui>

    <!-- ==================== Atmospheric Sun & Physically Based Lighting ==================== -->
    <scene>
      <ambient>0.65 0.70 0.75 1.0</ambient>
      <background>0.55 0.75 0.92 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>25 35 60 0 0.75 0.55</pose>
      <diffuse>0.98 0.95 0.88 1.0</diffuse>
      <specular>0.45 0.45 0.45 1.0</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- ==================== EXACT ROBOT MODEL: MARBLE_HUSKY_SENSOR_CONFIG_1 ==================== -->
    <include>
      <uri>model://marble_husky_sensor_config_1</uri>
      <name>forest_ugv</name>
      <pose>0.0 0.0 0.22 0 0 0</pose>
    </include>

    <!-- ==================== 500m x 500m 3D TERRAIN & MATERIAL PHYSICS ==================== -->
    <!-- Base Outskirts Grass/Soil Meadow (Material: Grass mu_s=0.55, mu_d=0.45) -->
    <model name="base_terrain_500m">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <surface><friction><ode><mu>0.55</mu><mu2>0.45</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.30 0.38 0.20 1.0</ambient>
            <diffuse>0.34 0.44 0.24 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Elevation Slopes & Rolling Hills (3D Topography) -->
    <model name="elevation_hill_north">
      <static>true</static>
      <pose>15.0 16.0 0.55 0.06 0.03 0.12</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>45.0 14.0 1.1</size></box></geometry>
          <surface><friction><ode><mu>0.50</mu><mu2>0.40</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>45.0 14.0 1.1</size></box></geometry>
          <material><ambient>0.26 0.34 0.18 1.0</ambient><diffuse>0.30 0.38 0.20 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="elevation_ridge_south">
      <static>true</static>
      <pose>20.0 -14.0 0.50 -0.05 0.04 -0.15</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>50.0 14.0 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.50</mu><mu2>0.40</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>50.0 14.0 1.0</size></box></geometry>
          <material><ambient>0.28 0.36 0.20 1.0</ambient><diffuse>0.32 0.40 0.22 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mud / Soft Soil Traction Patch (Material: Mud mu_s=0.35, mu_d=0.25) -->
    <model name="mud_patch_offroad">
      <static>true</static>
      <pose>16.0 3.0 0.015 0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.5 3.0 0.03</size></box></geometry>
          <surface><friction><ode><mu>0.35</mu><mu2>0.25</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.5 3.0 0.03</size></box></geometry>
          <material><ambient>0.22 0.16 0.10 1.0</ambient><diffuse>0.28 0.20 0.12 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== REALISTIC ROAD NETWORK ==================== -->
    <!-- 1. Main Asphalt Corridor (Material: Asphalt mu_s=0.90, mu_d=0.80) -->
    <model name="main_asphalt_road">
      <static>true</static>
      <pose>10.0 0.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>26.0 6.2 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.90</mu><mu2>0.80</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>26.0 6.2 0.02</size></box></geometry>
          <material><ambient>0.16 0.16 0.18 1.0</ambient><diffuse>0.20 0.20 0.22 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Double Yellow Road Centerline -->
    <model name="road_centerline_double_yellow">
      <static>true</static>
      <pose>10.0 0.0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>24.0 0.18 0.005</size></box></geometry>
          <material><ambient>0.95 0.85 0.10 1.0</ambient><diffuse>0.98 0.90 0.12 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Concrete Curbs & Sidewalks (Material: Concrete mu_s=0.85, mu_d=0.75) -->
    <model name="concrete_curb_north">
      <static>true</static>
      <pose>10.0 3.25 0.08 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>26.0 0.30 0.16</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.75</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>26.0 0.30 0.16</size></box></geometry>
          <material><ambient>0.70 0.70 0.72 1.0</ambient><diffuse>0.75 0.75 0.78 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="concrete_curb_south">
      <static>true</static>
      <pose>10.0 -3.25 0.08 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>26.0 0.30 0.16</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.75</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>26.0 0.30 0.16</size></box></geometry>
          <material><ambient>0.70 0.70 0.72 1.0</ambient><diffuse>0.75 0.75 0.78 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 2. North Crossroad / Off-Road Gravel Trail (Material: Gravel mu_s=0.60, mu_d=0.50) -->
    <model name="north_crossroad_gravel">
      <static>true</static>
      <pose>11.8 5.5 0.01 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>11.0 5.2 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.60</mu><mu2>0.50</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>11.0 5.2 0.02</size></box></geometry>
          <material><ambient>0.38 0.34 0.26 1.0</ambient><diffuse>0.44 0.38 0.30 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3. East Connector Road (Leading to Sector B Coordinates) -->
    <model name="east_sector_road">
      <static>true</static>
      <pose>17.5 8.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>14.0 5.0 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.75</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>14.0 5.0 0.02</size></box></geometry>
          <material><ambient>0.22 0.22 0.24 1.0</ambient><diffuse>0.26 0.26 0.28 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== REAL-WORLD DIGITAL-TWIN ARCHITECTURE ==================== -->
    <!-- Two-Story Residential Residence (East Sector) -->
    <model name="digital_twin_estate_1">
      <static>true</static>
      <pose>23.5 8.0 0.0 0 0 0</pose>
      <link name="ground_floor">
        <pose>0 0 2.2 0 0 0</pose>
        <collision name="col"><geometry><box><size>7.2 6.8 4.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>7.2 6.8 4.4</size></box></geometry>
          <material><ambient>0.82 0.80 0.76 1.0</ambient><diffuse>0.86 0.84 0.80 1.0</diffuse></material>
        </visual>
      </link>
      <link name="upper_floor">
        <pose>0 0 5.2 0 0 0</pose>
        <collision name="col"><geometry><box><size>6.4 6.0 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.4 6.0 2.2</size></box></geometry>
          <material><ambient>0.30 0.40 0.50 1.0</ambient><diffuse>0.35 0.45 0.55 1.0</diffuse></material>
        </visual>
      </link>
      <link name="entry_porch">
        <pose>-4.0 0 1.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.2 3.8 3.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 3.8 3.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1.0</ambient><diffuse>0.50 0.40 0.30 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outskirts Farmhouse & Garage (South Sector) -->
    <model name="farmhouse_south_1">
      <static>true</static>
      <pose>4.0 -7.5 2.2 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>6.5 5.5 4.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.5 5.5 4.4</size></box></geometry>
          <material><ambient>0.74 0.65 0.52 1.0</ambient><diffuse>0.78 0.70 0.56 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="farmhouse_south_2">
      <static>true</static>
      <pose>18.0 -7.5 2.2 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>6.8 5.8 4.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.8 5.8 4.4</size></box></geometry>
          <material><ambient>0.80 0.78 0.74 1.0</ambient><diffuse>0.84 0.82 0.78 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Workshop & Storage Barn (North-West Sector) -->
    <model name="barn_northwest">
      <static>true</static>
      <pose>4.5 8.5 2.2 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>6.4 5.2 4.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.4 5.2 4.4</size></box></geometry>
          <material><ambient>0.48 0.22 0.12 1.0</ambient><diffuse>0.52 0.26 0.16 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== TACTICAL ROADBLOCK & CIVILIAN VEHICLES ==================== -->
    <!-- Construction Barricade on Main Road at x=14.2m -->
    <model name="roadblock_barricade_x14">
      <static>true</static>
      <pose>14.2 0.0 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 5.4 1.1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 5.4 1.1</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1.0</ambient><diffuse>0.98 0.50 0.10 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parked Civilian Pickup Truck (Material: Metal mu_s=0.65) -->
    <model name="parked_pickup_truck">
      <static>true</static>
      <pose>7.5 -1.7 0.9 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>4.6 2.1 1.8</size></box></geometry>
          <surface><friction><ode><mu>0.65</mu><mu2>0.55</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>4.6 2.1 1.8</size></box></geometry>
          <material><ambient>0.15 0.28 0.50 1.0</ambient><diffuse>0.20 0.35 0.60 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parked Civilian Sedan (Sector B) -->
    <model name="parked_civilian_sedan">
      <static>true</static>
      <pose>21.0 4.8 0.85 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>4.3 1.9 1.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.3 1.9 1.6</size></box></geometry>
          <material><ambient>0.85 0.85 0.88 1.0</ambient><diffuse>0.90 0.90 0.94 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== NATURAL VEGETATION & GRANITE BOULDERS ==================== -->
    <!-- Mature Pine Trees -->
    <model name="pine_tree_cluster_1">
      <static>true</static>
      <pose>1.5 3.5 0 0 0 0</pose>
      <link name="trunk">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.26</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.26</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.30 0.20 0.12 1.0</ambient><diffuse>0.35 0.24 0.15 1.0</diffuse></material>
        </visual>
      </link>
      <link name="foliage">
        <pose>0 0 4.2 0 0 0</pose>
        <visual name="vis"><geometry><cone><radius>1.7</radius><length>3.6</length></cone></geometry>
          <material><ambient>0.10 0.32 0.14 1.0</ambient><diffuse>0.14 0.40 0.18 1.0</diffuse></material>
        </visual>
