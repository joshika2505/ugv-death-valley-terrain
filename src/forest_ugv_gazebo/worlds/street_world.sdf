<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="street_world">
    <!-- Physics Profile -->
    <physics name="1ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>60</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- GUI Camera Track -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.0 -5.0 5.0 0 0.5 0.8</pose>
        <view_controller>orbit</view_controller>
        <track>
          <target>forest_ugv</target>
          <min_dist>3.0</min_dist>
          <max_dist>12.0</max_dist>
        </track>
      </camera>
    </gui>

    <!-- PBR Natural Lighting -->
    <scene>
      <ambient>0.65 0.70 0.75 1.0</ambient>
      <background>0.55 0.75 0.92 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>25 35 60 0 0.75 0.55</pose>
      <diffuse>0.98 0.95 0.88 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- Ground Asphalt Collision Base -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <surface><friction><ode><mu>0.90</mu><mu2>0.80</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material><ambient>0.2 0.2 0.22 1.0</ambient><diffuse>0.25 0.25 0.28 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3D Realistic Street Architecture -->
    <include>
      <uri>model://street</uri>
      <name>street_environment</name>
      <pose>0.0 0.0 0.05 0 0 0</pose>
    </include>

    <!-- EXACT ROBOT: MARBLE_HUSKY_SENSOR_CONFIG_1 -->
    <include>
      <uri>model://marble_husky_sensor_config_1</uri>
      <name>forest_ugv</name>
      <pose>0.0 0.0 0.35 0 0 0</pose>
    </include>

  </world>
</sdf>
