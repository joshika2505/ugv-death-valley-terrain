          </geometry>
          <material>
            <ambient>0.40 0.38 0.36 1.0</ambient>
            <diffuse>0.50 0.48 0.45 1.0</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <box>
              <size>0.85 0.75 0.65</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Rock Cluster 1 -->
    <model name="rock_cluster_1">
      <static>true</static>
      <pose>4.2 1.6 0.30 0.1 0.1 0.8</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <sphere>
              <radius>0.40</radius>
