    <!-- Dangerous Ditch / Terrain Depression on Left Edge -->
    <model name="forest_ditch_hazard">
      <static>true</static>
      <pose>13.0 4.8 0.12 0 0 0.2</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>8.5 1.4 0.24</size>
