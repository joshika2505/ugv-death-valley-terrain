<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="forest_world">
    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <!-- Directional Sunlight with Forest Canopy Shadows -->
    <light type="directional" name="forest_sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 35 0.55 0.35 0.2</pose>
      <diffuse>0.88 0.86 0.78 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -1.0</direction>
    </light>

    <scene>
      <ambient>0.55 0.62 0.58 1.0</ambient>
      <background>0.48 0.68 0.85 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Base Forest Floor (Mossy Earth & Undergrowth) -->
    <model name="forest_floor">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.32 0.14 1.0</ambient>
            <diffuse>0.22 0.38 0.18 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Traversable Forest Dirt Trail (Point A -> Point B) -->
    <!-- Trail Segment 1 (0 to 5m) -->
    <model name="trail_segment_1">
      <static>true</static>
      <pose>2.5 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>5.5 2.4 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.40 0.26 1.0</ambient>
            <diffuse>0.62 0.48 0.32 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trail Segment 2 (5 to 10m, curving toward y=1.2) -->
    <model name="trail_segment_2">
      <static>true</static>
      <pose>7.5 0.6 0.002 0 0 0.15</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>5.5 2.4 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.40 0.26 1.0</ambient>
            <diffuse>0.62 0.48 0.32 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trail Segment 3 (10 to 15m, curving toward y=2.5) -->
    <model name="trail_segment_3">
      <static>true</static>
      <pose>12.5 2.0 0.002 0 0 0.28</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>5.5 2.4 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.40 0.26 1.0</ambient>
            <diffuse>0.62 0.48 0.32 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trail Segment 4 (15 to 20m, reaching Point B at y=4.0) -->
    <model name="trail_segment_4">
      <static>true</static>
      <pose>17.5 3.5 0.002 0 0 0.32</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>5.8 2.4 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.40 0.26 1.0</ambient>
            <diffuse>0.62 0.48 0.32 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start Platform: Point A (x=0.0, y=0.0) -->
    <model name="point_a_start_marker">
      <static>true</static>
      <pose>0.0 0.0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry>
            <cylinder>
              <radius>1.1</radius>
              <length>0.010</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.45 0.85 1.0</ambient>
            <diffuse>0.20 0.55 0.95 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Goal Platform & Visual Target Beacon: Point B (x=20.0, y=4.0) -->
    <model name="point_b_goal_marker">
      <static>true</static>
      <pose>20.0 4.0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry>
            <cylinder>
              <radius>1.3</radius>
              <length>0.010</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.80 0.35 1.0</ambient>
            <diffuse>0.25 0.90 0.45 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Target Beacon at Point B -->
    <model name="forest_goal_beacon">
      <static>true</static>
      <pose>20.0 4.0 0.8 0 0 3.14159</pose>
      <link name="link">
        <!-- Mast -->
        <visual name="mast">
          <pose>0 0 -0.3 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.75 0.15 1.0</ambient>
            <diffuse>0.95 0.85 0.20 1.0</diffuse>
          </material>
        </visual>
        <!-- High Contrast Target Board -->
        <visual name="board">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
          </material>
        </visual>
        <!-- Outer Target Ring (Black) -->
        <visual name="ring_outer">
          <pose>0.03 0 0.35 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1.0</ambient>
            <diffuse>0.05 0.05 0.05 1.0</diffuse>
          </material>
        </visual>
        <!-- Middle Ring (Bright Red) -->
        <visual name="ring_mid">
          <pose>0.035 0 0.35 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.90 0.15 0.10 1.0</ambient>
            <diffuse>0.98 0.20 0.15 1.0</diffuse>
          </material>
        </visual>
        <!-- Bullseye Center (Yellow) -->
        <visual name="ring_center">
          <pose>0.04 0 0.35 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.95 0.85 0.10 1.0</ambient>
            <diffuse>1.0 0.90 0.15 1.0</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.6</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ==================== Realistic Forest Elements: Trees, Logs, Rocks, Ditches ==================== -->

    <!-- Fallen Log on Right Shoulder near x=6.5 -->
    <model name="fallen_log_1">
      <static>true</static>
      <pose>6.5 -1.6 0.20 0 1.570796 0.4</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>3.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.32 0.20 0.10 1.0</ambient>
            <diffuse>0.42 0.28 0.15 1.0</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>3.2</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Unexpected Boulder on Path at x=10.5 requiring Dynamic Avoidance -->
    <model name="path_obstacle_boulder">
      <static>true</static>
      <pose>10.2 1.4 0.35 0.1 0.2 0.5</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>0.85 0.75 0.65</size>
