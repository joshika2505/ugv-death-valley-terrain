        <collision name="col">
          <geometry>
            <box>
              <size>8.5 1.4 0.24</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Pine Forest Trees Flanking the Trail -->
    <!-- Tree 1 -->
    <model name="tree_1">
      <static>true</static>
      <pose>3.5 3.0 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 1.1 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>2.2</length>
