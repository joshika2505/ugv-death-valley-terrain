<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="locality_hospital_world">
    <!-- ==================== Physics Engine Configuration ==================== -->
    <physics name="1ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ==================== Plugins ==================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- GUI Camera automatically tracks and follows the UGV in real time -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-4.0 -6.0 6.0 0 0.65 0.95</pose>
        <view_controller>orbit</view_controller>
        <track>
          <target>forest_ugv</target>
          <min_dist>3.0</min_dist>
          <max_dist>12.0</max_dist>
        </track>
      </camera>
    </gui>

    <!-- ==================== Atmosphere & Sun Lighting ==================== -->
    <scene>
      <ambient>0.6 0.65 0.7 1.0</ambient>
      <background>0.5 0.7 0.9 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>10 15 35 0 0.8 0.6</pose>
      <diffuse>0.95 0.92 0.85 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- ==================== MARBLE Husky Autonomous UGV ==================== -->
    <include>
      <uri>model://marble_husky_sensor_config_1</uri>
      <name>forest_ugv</name>
      <pose>0.0 0.0 0.22 0 0 0</pose>
    </include>

    <!-- ==================== Ground Terrain & Grass ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 60</size></plane></geometry>
          <material>
            <ambient>0.25 0.45 0.2 1.0</ambient>
            <diffuse>0.3 0.52 0.22 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== ROAD NETWORK ==================== -->
    <!-- Main Paved Road (East-West Axis, width 4.5m) -->
    <model name="main_road_segment1">
      <static>true</static>
      <pose>12.0 0.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>28.0 4.6 0.02</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>28.0 4.6 0.02</size></box></geometry>
          <material><ambient>0.18 0.18 0.20 1.0</ambient><diffuse>0.22 0.22 0.24 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main Road White Lane Markings -->
    <model name="road_centerline">
      <static>true</static>
      <pose>12.0 0.0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>26.0 0.15 0.005</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1.0</ambient><diffuse>0.95 0.95 0.95 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Crossroad / Detour Road leading North toward Hospital (North-South Axis, width 4.0m) -->
    <model name="hospital_crossroad">
      <static>true</static>
      <pose>12.0 4.5 0.01 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>9.0 4.0 0.02</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>9.0 4.0 0.02</size></box></geometry>
          <material><ambient>0.20 0.20 0.22 1.0</ambient><diffuse>0.24 0.24 0.26 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Hospital Approach Road (East-West Axis at y=8.0m, connecting crossroad to Hospital Point B) -->
    <model name="hospital_driveway">
      <static>true</static>
      <pose>18.0 8.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>14.0 4.2 0.02</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>14.0 4.2 0.02</size></box></geometry>
          <material><ambient>0.22 0.22 0.25 1.0</ambient><diffuse>0.26 0.26 0.30 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== SIDEWALKS & CURBS ==================== -->
    <!-- South Sidewalk (Main Road) -->
    <model name="sidewalk_south">
      <static>true</static>
      <pose>12.0 -3.0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>28.0 1.4 0.12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>28.0 1.4 0.12</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1.0</ambient><diffuse>0.6 0.6 0.62 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North Sidewalk Segment 1 -->
    <model name="sidewalk_north1">
      <static>true</static>
      <pose>5.0 3.0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12.0 1.4 0.12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>12.0 1.4 0.12</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1.0</ambient><diffuse>0.6 0.6 0.62 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North Sidewalk Segment 2 (Past crossroad) -->
    <model name="sidewalk_north2">
      <static>true</static>
      <pose>19.0 3.0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12.0 1.4 0.12</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>12.0 1.4 0.12</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1.0</ambient><diffuse>0.6 0.6 0.62 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== POINT B: HOSPITAL MEDICAL CENTER ==================== -->
    <model name="hospital_building">
      <static>true</static>
      <pose>24.0 8.0 0.0 0 0 0</pose>
      
      <!-- Main Clinic Multi-Story Wing -->
      <link name="hospital_main_wing">
        <pose>0 0 3.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>8.0 7.0 7.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>8.0 7.0 7.0</size></box></geometry>
          <material><ambient>0.85 0.88 0.92 1.0</ambient><diffuse>0.90 0.92 0.96 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Emergency Wing Entrance Portico -->
      <link name="hospital_portico">
        <pose>-4.2 0 1.8 0 0 0</pose>
        <collision name="col"><geometry><box><size>1.5 4.5 3.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.5 4.5 3.6</size></box></geometry>
          <material><ambient>0.2 0.4 0.7 1.0</ambient><diffuse>0.25 0.5 0.85 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Red Cross Medical Cross Symbol (Front Facing, visible to UGV camera) -->
      <link name="red_cross_horizontal">
        <pose>-4.98 0 2.2 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.08 1.8 0.5</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1.0</ambient><diffuse>1.0 0.1 0.1 1.0</diffuse><emissive>0.4 0.0 0.0 1.0</emissive></material>
        </visual>
      </link>
      <link name="red_cross_vertical">
        <pose>-4.98 0 2.2 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.08 0.5 1.8</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1.0</ambient><diffuse>1.0 0.1 0.1 1.0</diffuse><emissive>0.4 0.0 0.0 1.0</emissive></material>
        </visual>
      </link>

      <!-- Emergency Department Sign Banner -->
      <link name="hospital_sign">
        <pose>-4.98 0 3.3 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.06 3.2 0.6</size></box></geometry>
          <material><ambient>0.95 0.1 0.1 1.0</ambient><diffuse>0.95 0.15 0.15 1.0</diffuse></material>
        </visual>
      </link>

      <!-- Hospital Beacon Light (Cyan/White Pulse on roof) -->
      <link name="hospital_beacon">
        <pose>0 0 7.3 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.0 0.8 1.0 1.0</ambient><diffuse>0.0 0.9 1.0 1.0</diffuse><emissive>0.0 0.7 1.0 1.0</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Ambulance Parked at Hospital Bay -->
    <model name="parked_ambulance">
      <static>true</static>
      <pose>21.5 5.2 0.85 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.1 4.5 1.7</size></box></geometry></collision>
        <visual name="body">
          <geometry><box><size>2.1 4.5 1.7</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1.0</ambient><diffuse>0.98 0.98 0.98 1.0</diffuse></material>
        </visual>
        <visual name="red_stripe">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>2.15 4.52 0.35</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1.0</ambient><diffuse>1.0 0.1 0.1 1.0</diffuse></material>
        </visual>
        <visual name="siren_light">
          <pose>0 0 0.95 0 0 0</pose>
          <geometry><box><size>0.8 0.4 0.15</size></box></geometry>
          <material><ambient>0.1 0.2 0.9 1.0</ambient><diffuse>0.2 0.3 1.0 1.0</diffuse><emissive>0.1 0.2 0.8 1.0</emissive></material>
        </visual>
      </link>
    </model>

    <!-- ==================== RESIDENTIAL BUILDINGS ==================== -->
    <!-- House 1: West Residential (Near Point A Start) -->
    <model name="house_1">
      <static>true</static>
      <pose>3.0 -7.0 0.0 0 0 0</pose>
      <link name="link">
        <pose>0 0 2.2 0 0 0</pose>
        <collision name="col"><geometry><box><size>6.0 5.5 4.4</size></box></geometry></collision>
        <visual name="body">
          <geometry><box><size>6.0 5.5 4.4</size></box></geometry>
          <material><ambient>0.72 0.65 0.58 1.0</ambient><diffuse>0.78 0.70 0.62 1.0</diffuse></material>
        </visual>
        <visual name="roof">
          <pose>0 0 2.6 0 0 0</pose>
          <geometry><box><size>6.4 5.9 0.8</size></box></geometry>
          <material><ambient>0.55 0.22 0.15 1.0</ambient><diffuse>0.62 0.26 0.18 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- House 2: Central Residential South -->
    <model name="house_2">
      <static>true</static>
      <pose>12.0 -7.5 0.0 0 0 0</pose>
      <link name="link">
        <pose>0 0 2.4 0 0 0</pose>
        <collision name="col"><geometry><box><size>7.0 5.0 4.8</size></box></geometry></collision>
        <visual name="body">
          <geometry><box><size>7.0 5.0 4.8</size></box></geometry>
          <material><ambient>0.60 0.65 0.70 1.0</ambient><diffuse>0.68 0.72 0.78 1.0</diffuse></material>
        </visual>
        <visual name="roof">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry><box><size>7.4 5.4 0.8</size></box></geometry>
          <material><ambient>0.25 0.28 0.32 1.0</ambient><diffuse>0.30 0.34 0.38 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- House 3: East Residential South -->
    <model name="house_3">
      <static>true</static>
      <pose>21.0 -7.0 0.0 0 0 0</pose>
      <link name="link">
        <pose>0 0 2.2 0 0 0</pose>
        <collision name="col"><geometry><box><size>6.5 5.5 4.4</size></box></geometry></collision>
        <visual name="body">
          <geometry><box><size>6.5 5.5 4.4</size></box></geometry>
          <material><ambient>0.75 0.70 0.60 1.0</ambient><diffuse>0.82 0.76 0.66 1.0</diffuse></material>
        </visual>
        <visual name="roof">
          <pose>0 0 2.6 0 0 0</pose>
          <geometry><box><size>6.9 5.9 0.8</size></box></geometry>
          <material><ambient>0.50 0.20 0.15 1.0</ambient><diffuse>0.58 0.24 0.18 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- House 4: Northwest Residential House -->
    <model name="house_4">
      <static>true</static>
      <pose>4.0 7.5 0.0 0 0 0</pose>
      <link name="link">
        <pose>0 0 2.2 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.5 5.0 4.4</size></box></geometry></collision>
        <visual name="body">
          <geometry><box><size>5.5 5.0 4.4</size></box></geometry>
          <material><ambient>0.65 0.60 0.55 1.0</ambient><diffuse>0.72 0.68 0.62 1.0</diffuse></material>
        </visual>
        <visual name="roof">
          <pose>0 0 2.6 0 0 0</pose>
          <geometry><box><size>5.9 5.4 0.8</size></box></geometry>
          <material><ambient>0.30 0.35 0.40 1.0</ambient><diffuse>0.35 0.42 0.48 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== PARKED VEHICLES ==================== -->
    <!-- Parked SUV (South Roadside at x=7.0m) -->
    <model name="parked_suv">
      <static>true</static>
      <pose>7.0 -1.6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.2 1.8 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.2 1.8 1.5</size></box></geometry>
          <material><ambient>0.15 0.25 0.55 1.0</ambient><diffuse>0.20 0.35 0.75 1.0</diffuse></material>
