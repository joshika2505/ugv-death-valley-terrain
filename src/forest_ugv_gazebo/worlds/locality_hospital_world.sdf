        </visual>
      </link>
    </model>

    <!-- Parked Sedan (North Roadside at x=16.5m) -->
    <model name="parked_sedan">
      <static>true</static>
      <pose>16.5 1.6 0.65 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 1.7 1.3</size></box></geometry></collision>
        <visual name="vis">
