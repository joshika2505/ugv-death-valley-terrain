          <material><ambient>0.1 0.1 0.1 1.0</ambient><diffuse>0.1 0.1 0.1 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== LOCALITY OBSTACLES & TERRAIN FEATURES ==================== -->
    <!-- Road Work Construction Barrier on Main Road at x=13.0m (Forcing UGV to use the Hospital Crossroad Detour!) -->
    <model name="roadwork_barrier_center">
      <static>true</static>
      <pose>14.2 -0.2 0.5 0 0 0.1</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 3.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 3.2 1.0</size></box></geometry>
          <material><ambient>0.95 0.5 0.0 1.0</ambient><diffuse>1.0 0.55 0.0 1.0</diffuse></material>
        </visual>
        <visual name="stripe1">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.62 3.22 0.25</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1.0</ambient><diffuse>1.0 1.0 1.0 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Traffic Cones near Barrier -->
    <model name="traffic_cone_1">
      <static>true</static>
      <pose>13.2 1.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry>
