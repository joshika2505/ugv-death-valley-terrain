          <geometry><cylinder><radius>0.22</radius><length>0.7</length></cylinder></geometry>
          <material><ambient>1.0 0.4 0.0 1.0</ambient><diffuse>1.0 0.45 0.0 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Gentle Slope & Uneven Grass Area in Northwest Park -->
    <model name="park_uneven_mound">
      <static>true</static>
      <pose>8.0 7.5 0.25 0 0.08 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.5 4.0 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.5 4.0 0.5</size></box></geometry>
          <material><ambient>0.28 0.48 0.22 1.0</ambient><diffuse>0.32 0.55 0.25 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Park Decorative Boulder -->
    <model name="park_boulder">
      <static>true</static>
      <pose>10.2 6.8 0.45 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.9 0.9 0.9</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.9 0.9 0.9</size></box></geometry>
          <material><ambient>0.42 0.42 0.45 1.0</ambient><diffuse>0.48 0.48 0.52 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== VEGETATION & TREES ==================== -->
    <!-- Tree 1 (Near Point A Start) -->
    <model name="tree_1">
      <static>true</static>
      <pose>1.5 3.2 0 0 0 0</pose>
      <link name="trunk">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.22</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.22</radius><length>3.0</length></cylinder></geometry><material><ambient>0.4 0.25 0.15 1.0</ambient><diffuse>0.45 0.3 0.18 1.0</diffuse></material></visual>
      </link>
      <link name="foliage">
        <pose>0 0 3.8 0 0 0</pose>
        <visual name="vis"><geometry><sphere><radius>1.4</radius></sphere></geometry><material><ambient>0.15 0.5 0.15 1.0</ambient><diffuse>0.2 0.6 0.2 1.0</diffuse></material></visual>
      </link>
    </model>

    <!-- Tree 2 (Along Crossroad) -->
    <model name="tree_2">
      <static>true</static>
      <pose>9.5 3.8 0 0 0 0</pose>
      <link name="trunk">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.24</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.24</radius><length>3.0</length></cylinder></geometry><material><ambient>0.4 0.25 0.15 1.0</ambient><diffuse>0.45 0.3 0.18 1.0</diffuse></material></visual>
      </link>
      <link name="foliage">
        <pose>0 0 3.8 0 0 0</pose>
        <visual name="vis"><geometry><sphere><radius>1.5</radius></sphere></geometry><material><ambient>0.18 0.55 0.18 1.0</ambient><diffuse>0.22 0.65 0.22 1.0</diffuse></material></visual>
      </link>
    </model>

    <!-- Tree 3 (Near Hospital Point B) -->
    <model name="tree_3">
      <static>true</static>
      <pose>15.5 11.2 0 0 0 0</pose>
      <link name="trunk">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.25</radius><length>3.0</length></cylinder></geometry><material><ambient>0.4 0.25 0.15 1.0</ambient><diffuse>0.45 0.3 0.18 1.0</diffuse></material></visual>
      </link>
      <link name="foliage">
        <pose>0 0 3.8 0 0 0</pose>
        <visual name="vis"><geometry><sphere><radius>1.6</radius></sphere></geometry><material><ambient>0.15 0.5 0.15 1.0</ambient><diffuse>0.2 0.6 0.2 1.0</diffuse></material></visual>
      </link>
    </model>

    <!-- Tree 4 (South Park Lawn) -->
    <model name="tree_4">
      <static>true</static>
      <pose>17.0 -3.6 0 0 0 0</pose>
