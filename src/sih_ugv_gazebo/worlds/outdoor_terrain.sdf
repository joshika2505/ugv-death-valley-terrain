    <!-- Forest Trees surrounding the outdoor terrain -->
    <!-- Tree 1 -->
    <model name="tree_1">
      <static>true</static>
      <pose>3.5 3.2 0 0 0 0</pose>
      <link name="link">
        <!-- Trunk -->
        <visual name="trunk">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.2</radius>
