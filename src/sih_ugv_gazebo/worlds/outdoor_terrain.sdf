<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="outdoor_terrain_world">
    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0.6 0.4 0.2</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <scene>
      <ambient>0.6 0.65 0.7 1.0</ambient>
      <background>0.5 0.7 0.9 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Base Outdoor Terrain (Grass / Off-road ground) -->
    <model name="outdoor_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.1</mu>
                <mu2>1.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.38 0.18 1.0</ambient>
            <diffuse>0.28 0.45 0.22 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Traversable Dirt Path Segments (Connecting Point A to Point B) -->
    <!-- Segment 1: Start section (0 to 6m) -->
    <model name="path_segment_1">
      <static>true</static>
      <pose>3.0 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>6.5 2.2 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.42 0.28 1.0</ambient>
            <diffuse>0.65 0.52 0.35 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Segment 2: Curved transition section (6 to 12m, angled toward y=2) -->
    <model name="path_segment_2">
      <static>true</static>
      <pose>8.8 1.0 0.002 0 0 0.25</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>6.2 2.2 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.42 0.28 1.0</ambient>
            <diffuse>0.65 0.52 0.35 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Segment 3: Goal approach section (12 to 18m, ending at Point B) -->
    <model name="path_segment_3">
      <static>true</static>
      <pose>14.8 3.0 0.002 0 0 0.35</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box>
              <size>6.8 2.2 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.42 0.28 1.0</ambient>
            <diffuse>0.65 0.52 0.35 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start Pad (Point A at x=0, y=0) -->
    <model name="start_pad_point_a">
      <static>true</static>
      <pose>0.0 0.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>1.0</radius>
              <length>0.008</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.8 1.0</ambient>
            <diffuse>0.1 0.5 0.9 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Beacon & Goal Pad (Point B at x=18.0, y=4.2) -->
    <model name="goal_pad_point_b">
      <static>true</static>
      <pose>18.0 4.2 0.005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>1.2</radius>
              <length>0.008</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.3 1.0</ambient>
            <diffuse>0.2 0.85 0.35 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Target Beacon Stand with AprilTag / Fiducial Marker -->
    <model name="visual_beacon_target">
      <static>true</static>
      <pose>18.0 4.2 0.75 0 0 3.14159</pose> <!-- facing toward the oncoming robot -->
      <link name="link">
        <!-- Beacon Pole -->
        <visual name="pole">
          <pose>0 0 -0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.1 1.0</ambient>
            <diffuse>0.9 0.9 0.2 1.0</diffuse>
          </material>
        </visual>
        <!-- Beacon Target Sign -->
        <visual name="target_board">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry>
            <box>
              <size>0.04 0.6 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.95 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
          </material>
        </visual>
        <!-- High Contrast Visual Bullseye / Fiducial Marker -->
        <visual name="fiducial_outer">
          <pose>0.025 0 0.35 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1.0</ambient>
            <diffuse>0.05 0.05 0.05 1.0</diffuse>
          </material>
        </visual>
        <visual name="fiducial_inner">
          <pose>0.03 0 0.35 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.14</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.2 0.1 1.0</ambient>
            <diffuse>0.95 0.25 0.1 1.0</diffuse>
          </material>
        </visual>
        <visual name="fiducial_center">
          <pose>0.035 0 0.35 0 1.570796 0</pose>
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.1 1.0</ambient>
            <diffuse>0.95 0.95 0.2 1.0</diffuse>
          </material>
        </visual>
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>1.5</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ==================== Outdoor Obstacles & Hazards ==================== -->

    <!-- Boulders / Rocks along path boundaries and terrain -->
    <model name="boulder_1">
      <static>true</static>
      <pose>4.2 -1.4 0.35 0.1 0.2 0.4</pose>
      <link name="link">
