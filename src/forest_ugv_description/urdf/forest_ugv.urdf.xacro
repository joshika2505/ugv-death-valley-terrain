<?xml version="1.0"?>
<robot name="forest_ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="sim" default="true" />

  <!-- Base Footprint -->
  <link name="base_footprint" />

  <!-- Base Link (MARBLE Clearpath Husky Chassis) -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.000543 -0.084945 0.062329" rpy="0 0 0" />
      <mass value="46.064" />
      <inertia ixx="0.615397" ixy="-0.0240585" ixz="-0.120749" iyy="1.75388" iyz="-0.0028322" izz="2.03641" />
    </inertial>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0" />
      <geometry>
        <box size="0.9874 0.5709 0.05" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/base_link.dae" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/top_chassis.dae" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/top_plate.dae" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/bumper.dae" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/user_rail.dae" />
      </geometry>
    </visual>
    <!-- Sensor Arch -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/jpl04_arch_nosensor.stl" />
      </geometry>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.165" rpy="0 0 0" />
  </joint>

  <!-- ==================== WHEEL MACRO ==================== -->
  <xacro:macro name="husky_wheel" params="prefix x_offset y_offset">
    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="2.637" />
        <inertia ixx="0.02467" ixy="0" ixz="0" iyy="0.04411" iyz="0" izz="0.02467" />
      </inertial>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="0.1651" length="0.1143" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/wheel.dae" />
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${x_offset} ${y_offset} 0.03282" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <xacro:husky_wheel prefix="front_left"  x_offset="0.256"  y_offset="0.2854" />
  <xacro:husky_wheel prefix="front_right" x_offset="0.256"  y_offset="-0.2854" />
  <xacro:husky_wheel prefix="rear_left"   x_offset="-0.256" y_offset="0.2854" />
  <xacro:husky_wheel prefix="rear_right"  x_offset="-0.256" y_offset="-0.2854" />

  <!-- ==================== SENSORS ==================== -->
  <!-- Realsense Camera (Front) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/realsense.dae" />
      </geometry>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.468 0 0.360" rpy="0 0 0" />
  </joint>

  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- 3D LiDAR (VLP-16) -->
  <link name="velodyne_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/VLP16_base_1.dae" />
      </geometry>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://forest_ugv_description/models/marble_husky_sensor_config_1/meshes/VLP16_base_2.dae" />
      </geometry>
    </visual>
  </link>

  <joint name="velodyne_base_joint" type="fixed">
    <parent link="base_link" />
    <child link="velodyne_base_link" />
    <origin xyz="0.424 0 0.387" rpy="0 0 0" />
  </joint>

  <!-- IMU Link -->
  <link name="imu_link" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <xacro:include filename="$(find forest_ugv_description)/urdf/gazebo_plugins.xacro" />

</robot>
