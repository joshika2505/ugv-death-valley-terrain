<?xml version="1.0"?>
<robot name="forest_ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Primary Navigation Sensor: RGB Camera ==================== -->
  <!-- Mast structure -->
  <link name="camera_mast">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.16" />
      </geometry>
      <material name="mast_gold" />
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.16" />
      </geometry>
    </collision>
  </link>

  <joint name="camera_mast_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_mast" />
    <origin xyz="0.18 0.0 0.20" rpy="0 0 0" />
  </joint>

  <!-- Camera Body & Raspberry Pi Camera Module V3 Assembly -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <!-- Anodized Mounting Bracket -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.035 0.08 0.035" />
      </geometry>
      <material name="camera_case" />
    </visual>
    <!-- Raspberry Pi Camera V3 PCB (Sony IMX708) -->
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.004 0.025 0.024" />
      </geometry>
      <material name="chassis_graphite" />
    </visual>
    <!-- Pi Camera V3 Optical Lens Barrel -->
    <visual>
      <origin xyz="0.026 0 0" rpy="0 1.570796 0" />
      <geometry>
        <cylinder radius="0.007" length="0.008" />
      </geometry>
      <material name="mast_gold" />
    </visual>
    <!-- Flexible CSI Ribbon Cable -->
    <visual>
      <origin xyz="-0.04 0 -0.04" rpy="0 0.45 0" />
      <geometry>
        <box size="0.10 0.016 0.001" />
      </geometry>
      <material name="mast_gold" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.08 0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_mast" />
    <child link="camera_link" />
    <!-- Mounted forward with downward pitch (0.12 rad / 7 deg) for forest trail & hazard detection -->
    <origin xyz="0.02 0 0.16" rpy="0 0.12 0" />
  </joint>

  <link name="camera_optical_frame" />

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796" />
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.43117</horizontal_fov> <!-- 82 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>35.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ==================== 6-Axis Inertial Measurement Unit (IMU) ==================== -->
  <link name="imu_link" />

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.10" rpy="0 0 0" />
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================== Ground Truth Evaluation Sensor: Isolated GPS ==================== -->
  <link name="gps_link" />

  <joint name="gps_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="-0.10 0 0.22" rpy="0 0 0" />
  </joint>

  <gazebo reference="gps_link">
    <sensor name="navsat_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/gps/ground_truth</topic>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ==================== GOOGLE GEMINI NEURAL BRAIN COMPUTE UNIT ==================== -->
  <link name="gemini_neural_brain">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.003" />
    </inertial>
    <!-- Neural Processor Housing -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.20 0.06" />
      </geometry>
      <material name="chassis_graphite" />
    </visual>
    <!-- Glowing Gemini Neural Cognitive Core Dome -->
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.055" />
      </geometry>
      <material name="mast_gold" />
    </visual>
    <!-- High-Gain Cognitive Antenna -->
    <visual>
      <origin xyz="-0.08 0.07 0.10" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.10" />
      </geometry>
      <material name="camera_case" />
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.20 0.08" />
      </geometry>
    </collision>
  </link>

  <joint name="gemini_neural_brain_joint" type="fixed">
    <parent link="base_link" />
    <child link="gemini_neural_brain" />
    <origin xyz="-0.02 0.0 0.20" rpy="0 0 0" />
  </joint>

  <gazebo reference="gemini_neural_brain">
    <visual>
      <material>
        <ambient>0.65 0.25 0.95 1.0</ambient>
        <diffuse>0.75 0.35 1.0 1.0</diffuse>
        <emissive>0.40 0.15 0.85 1.0</emissive>
      </material>
    </visual>
  </gazebo>

</robot>
