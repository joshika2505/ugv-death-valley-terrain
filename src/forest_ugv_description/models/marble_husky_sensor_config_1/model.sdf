<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
    <model name="forest_ugv">
        <link name="base_link">
            <pose>0 0 0 0 0 0</pose>
            <inertial>
                <pose>-0.000543 -0.084945 0.062329 0 0 0</pose>
                <mass>46.064</mass>
                <inertia>
                    <ixx>0.615397</ixx>
                    <ixy>-0.0240585</ixy>
                    <ixz>-0.120749</ixz>
                    <iyy>1.75388</iyy>
                    <iyz>-0.0028322</iyz>
                    <izz>2.03641</izz>
                </inertia>
            </inertial>
            <collision name="base_link_collision">
                <pose>0 0 0.12 0 0 0</pose>
                <geometry>
                    <box><size>0.9874 0.5709 0.05</size></box>
                </geometry>
            </collision>
            <collision name="base_link_collision_bottom">
                <pose>0 0 0.046 0 0 0</pose>
                <geometry>
                    <box><size>0.80 0.5709 0.095</size></box>
                </geometry>
            </collision>

            <!-- Exact MARBLE Husky High-Fidelity Meshes -->
            <visual name="base_link_visual">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/base_link.dae</uri></mesh>
                </geometry>
            </visual>
            <visual name="top_chassis_visual">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/top_chassis.dae</uri></mesh>
                </geometry>
            </visual>
            <visual name="top_plate_visual">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/top_plate.dae</uri></mesh>
                </geometry>
            </visual>
            <visual name="bumper_front_visual">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/bumper.dae</uri></mesh>
                </geometry>
            </visual>
            <visual name="user_rail_visual">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/user_rail.dae</uri></mesh>
                </geometry>
            </visual>
            <visual name="realsense_camera_visual">
                <pose>0.468 0 0.285 0 0 0</pose>
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/realsense.dae</uri></mesh>
                </geometry>
            </visual>
            <visual name="vlp16_base_visual">
                <pose>0.424 0 0.327 0 0 0</pose>
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/VLP16_base_1.dae</uri></mesh>
                </geometry>
            </visual>
            <visual name="vlp16_scan_visual">
                <pose>0.424 0 0.327 0 0 0</pose>
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/VLP16_scan.dae</uri></mesh>
                </geometry>
            </visual>

            <!-- Front RealSense Camera Sensor (Sony IMX / RealSense RGB) -->
            <sensor name="camera_front" type="camera">
                <topic>/camera/image_raw</topic>
                <camera_info_topic>/camera/camera_info</camera_info_topic>
                <camera name="camera_front">
                    <horizontal_fov>1.5184</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>300</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>1</visualize>
                <pose>0.468 0 0.285 0 0 0</pose>
            </sensor>

            <!-- IMU Sensor -->
            <sensor name="imu_sensor" type="imu">
                <topic>/imu/data</topic>
                <always_on>1</always_on>
                <update_rate>50</update_rate>
                <pose>0 0 0 0 0 0</pose>
            </sensor>
        </link>

        <!-- ==================== 4WD HUSKY WHEELS WITH DAE MESHES ==================== -->
        <!-- Front Left Wheel -->
        <link name="front_left_wheel_link">
            <pose>0.256 0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx><ixy>0</ixy><ixz>0</ixz>
                    <iyy>0.04411</iyy><iyz>0</iyz><izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="col">
                <pose>0 0 0 1.5708 0 0</pose>
                <geometry><cylinder><radius>0.1651</radius><length>0.1143</length></cylinder></geometry>
                <surface><friction><ode><mu>1.0</mu><mu2>0.02</mu2></ode></friction></surface>
            </collision>
            <visual name="vis">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/wheel.dae</uri></mesh>
                </geometry>
            </visual>
        </link>
        <joint name="front_left_wheel_joint" type="revolute">
            <child>front_left_wheel_link</child>
            <parent>base_link</parent>
            <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
        </joint>

        <!-- Front Right Wheel -->
        <link name="front_right_wheel_link">
            <pose>0.256 -0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx><ixy>0</ixy><ixz>0</ixz>
                    <iyy>0.04411</iyy><iyz>0</iyz><izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="col">
                <pose>0 0 0 1.5708 0 0</pose>
                <geometry><cylinder><radius>0.1651</radius><length>0.1143</length></cylinder></geometry>
                <surface><friction><ode><mu>1.0</mu><mu2>0.02</mu2></ode></friction></surface>
            </collision>
            <visual name="vis">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/wheel.dae</uri></mesh>
                </geometry>
            </visual>
        </link>
        <joint name="front_right_wheel_joint" type="revolute">
            <child>front_right_wheel_link</child>
            <parent>base_link</parent>
            <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
        </joint>

        <!-- Rear Left Wheel -->
        <link name="rear_left_wheel_link">
            <pose>-0.256 0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx><ixy>0</ixy><ixz>0</ixz>
                    <iyy>0.04411</iyy><iyz>0</iyz><izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="col">
                <pose>0 0 0 1.5708 0 0</pose>
                <geometry><cylinder><radius>0.1651</radius><length>0.1143</length></cylinder></geometry>
                <surface><friction><ode><mu>1.0</mu><mu2>0.02</mu2></ode></friction></surface>
            </collision>
            <visual name="vis">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/wheel.dae</uri></mesh>
                </geometry>
            </visual>
        </link>
        <joint name="rear_left_wheel_joint" type="revolute">
            <child>rear_left_wheel_link</child>
            <parent>base_link</parent>
            <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
        </joint>

        <!-- Rear Right Wheel -->
        <link name="rear_right_wheel_link">
            <pose>-0.256 -0.2854 0.03282 0 0 0</pose>
            <inertial>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx><ixy>0</ixy><ixz>0</ixz>
                    <iyy>0.04411</iyy><iyz>0</iyz><izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="col">
                <pose>0 0 0 1.5708 0 0</pose>
                <geometry><cylinder><radius>0.1651</radius><length>0.1143</length></cylinder></geometry>
                <surface><friction><ode><mu>1.0</mu><mu2>0.02</mu2></ode></friction></surface>
            </collision>
            <visual name="vis">
                <geometry>
                    <mesh><uri>model://marble_husky_sensor_config_1/meshes/wheel.dae</uri></mesh>
                </geometry>
            </visual>
        </link>
        <joint name="rear_right_wheel_joint" type="revolute">
            <child>rear_right_wheel_link</child>
            <parent>base_link</parent>
            <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
        </joint>

        <!-- ==================== PLUGINS ==================== -->
        <!-- 4WD Differential Drive System -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <wheel_separation>0.5709</wheel_separation>
            <wheel_radius>0.1651</wheel_radius>
            <max_linear_acceleration>2.5</max_linear_acceleration>
            <min_linear_acceleration>-2.5</min_linear_acceleration>
            <max_angular_acceleration>3.2</max_angular_acceleration>
            <min_angular_acceleration>-3.2</min_angular_acceleration>
            <max_linear_velocity>1.5</max_linear_velocity>
            <min_linear_velocity>-1.5</min_linear_velocity>
            <max_angular_velocity>2.0</max_angular_velocity>
            <min_angular_velocity>-2.0</min_angular_velocity>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>

        <!-- Joint State Publisher -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>
        </plugin>

        <static>0</static>
    </model>
</sdf>
