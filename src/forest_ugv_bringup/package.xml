<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forest_ugv_bringup</name>
  <version>1.0.0</version>
  <description>Master Bringup and Integrated Mission Launchers for Forest UGV</description>
  <maintainer email="forest_ugv@example.com">Forest UGV Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>forest_ugv_description</exec_depend>
  <exec_depend>forest_ugv_gazebo</exec_depend>
  <exec_depend>forest_perception</exec_depend>
  <exec_depend>forest_visual_slam</exec_depend>
  <exec_depend>forest_mapping</exec_depend>
  <exec_depend>forest_planner</exec_depend>
  <exec_depend>forest_controller</exec_depend>
  <exec_depend>forest_evaluation</exec_depend>
  <exec_depend>forest_visualization</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
