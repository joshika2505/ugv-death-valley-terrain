<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="small_mountain_world">
    <gui>
      <camera name="user_camera">
        <pose>0.0 -2500.0 1350.0 0.0 0.45 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <scene>
      <ambient>0.50 0.55 0.65 1.0</ambient>
      <background>0.50 0.72 0.95 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <time>11</time>
        <sunrise>6</sunrise>
        <sunset>19</sunset>
        <clouds>
          <speed>8</speed>
        </clouds>
      </sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 -5000 6000 0 0 0</pose>
      <diffuse>0.96 0.92 0.82 1.0</diffuse>
      <specular>0.0 0.0 0.0 1.0</specular>
      <direction>0.0 0.6 -0.6</direction>
    </light>

    <model name="valley_landscape">
      <static>true</static>
      <pose>0 0 -2.0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>16000 16000</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>16000 16000</size></plane></geometry>
          <material>
            <ambient>0.24 0.32 0.18 1.0</ambient>
            <diffuse>0.30 0.40 0.22 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="small_mountain_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://small_mountain_terrain/meshes/small_mountain_collision.stl</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="surface_visual">
          <geometry>
            <mesh>
              <uri>model://small_mountain_terrain/meshes/mountain_surface.obj</uri>
            </mesh>
          </geometry>
        </visual>
        <visual name="bedrock_visual">
          <geometry>
            <mesh>
              <uri>model://small_mountain_terrain/meshes/mountain_bedrock.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.24 0.22 0.20 1.0</ambient>
            <diffuse>0.34 0.30 0.26 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
