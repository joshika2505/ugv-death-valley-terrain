<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="test_pure">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    
    <scene>
      <ambient>0.6 0.65 0.7 1.0</ambient>
      <background>0.5 0.7 0.95 1.0</background>
    </scene>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0.5 0.7 0.95</background_color>
        <camera_pose>0.0 -1800.0 1200.0 0.0 0.55 1.5708</camera_pose>
        <camera_clip>
          <near>1.0</near>
          <far>15000.0</far>
        </camera_clip>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 1000 0.4 0.6 0</pose>
      <diffuse>0.95 0.90 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <model name="mountain">
      <static>true</static>
      <link name="l">
        <visual name="v">
          <geometry>
            <mesh>
              <uri>/tmp/mountain_pure.obj</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <pbr>
              <metal>
                <albedo_map>/home/ubuntu/sih_ws/install/small_mountain_world/share/small_mountain_world/textures/overlay.png</albedo_map>
                <roughness>0.85</roughness>
                <metalness>0.02</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
