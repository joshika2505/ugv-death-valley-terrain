<?xml version="1.0"?>
<robot name="ugv_belt_drive" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================
       UGV BELT-DRIVE TERRAIN ROBOT
       - Skid-steer track (belt) drive: front driven sprocket +
         rear idler sprocket per side, joined by a visual belt.
       - Pan-tilt rover-style camera (mast mounted, wide coverage).
       - 2D LiDAR for SLAM (gmapping / slam_toolbox / cartographer).
       - IMU, GPS mast, and electronics/battery enclosures.
       Tested conceptually against ROS 2 + Gazebo Classic plugins.
       ========================================================= -->

  <!-- ============================ PROPERTIES ============================ -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.50"/>
  <xacro:property name="chassis_width"  value="0.34"/>
  <xacro:property name="chassis_height" value="0.14"/>
  <xacro:property name="chassis_mass"   value="28.0"/>
  <xacro:property name="ground_clearance" value="0.07"/>

  <!-- Track / belt drive -->
  <xacro:property name="sprocket_radius" value="0.065"/>
  <xacro:property name="sprocket_width"  value="0.05"/>
  <xacro:property name="sprocket_mass"   value="1.2"/>
  <xacro:property name="track_separation" value="0.40"/>      <!-- distance between left/right track centers -->
  <xacro:property name="track_wheelbase"  value="0.34"/>      <!-- distance between front and rear sprocket -->
  <xacro:property name="belt_thickness"   value="0.02"/>

  <!-- Mast / sensors -->
  <xacro:property name="mast_height" value="0.22"/>
  <xacro:property name="mast_radius" value="0.015"/>

  <!-- ============================ MATERIALS ============================= -->
  <material name="matte_black">  <color rgba="0.05 0.05 0.05 1.0"/> </material>
  <material name="signal_yellow"><color rgba="1.0 0.78 0.0 1.0"/>  </material>
  <material name="dark_grey">    <color rgba="0.2 0.2 0.2 1.0"/>   </material>
  <material name="lens_glass">   <color rgba="0.1 0.1 0.12 0.9"/>  </material>

  <!-- ============================ INERTIA MACRO =========================== -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <origin xyz="0 0 -0.06" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12.0*(y*y+z*z) + 0.1}" ixy="0.0" ixz="0.0"
               iyy="${mass/12.0*(x*x+z*z) + 0.1}" iyz="0.0"
               izz="${mass/12.0*(x*x+y*y) + 0.2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12.0*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
               iyy="${mass/12.0*(3*r*r+h*h)}" iyz="0.0"
               izz="${mass*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================ BASE FOOTPRINT ========================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${ground_clearance + sprocket_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ CHASSIS ================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="${chassis_length*0.9} ${chassis_width*0.8} ${chassis_height*0.7}"/></geometry>
    </collision>
    <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- Yellow chassis trim strip (branding accent, purely cosmetic) -->
  <link name="trim_strip">
    <visual>
      <geometry><box size="${chassis_length*0.9} 0.02 0.01"/></geometry>
      <material name="signal_yellow"/>
    </visual>
  </link>
  <joint name="trim_strip_joint" type="fixed">
    <parent link="base_link"/>
    <child link="trim_strip"/>
    <origin xyz="0 0 ${chassis_height/2 + 0.006}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ BELT-DRIVE TRACK MACRO ================= -->
  <!-- Each side: front sprocket (driven), rear sprocket (idler), belt shell -->
  <xacro:macro name="track_side" params="side y_sign driven">
    <!-- Front (driven) sprocket -->
    <link name="${side}_front_sprocket">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${sprocket_radius}" length="${sprocket_width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${sprocket_radius}" length="${sprocket_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia mass="${sprocket_mass}" r="${sprocket_radius}" h="${sprocket_width}"/>
    </link>

    <joint name="${side}_front_sprocket_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_front_sprocket"/>
      <origin xyz="${track_wheelbase/2} ${y_sign*(track_separation/2)} ${-ground_clearance}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="250.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <!-- Rear (idler) sprocket -->
    <link name="${side}_rear_sprocket">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${sprocket_radius}" length="${sprocket_width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${sprocket_radius}" length="${sprocket_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia mass="${sprocket_mass}" r="${sprocket_radius}" h="${sprocket_width}"/>
    </link>

    <joint name="${side}_rear_sprocket_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_rear_sprocket"/>
      <origin xyz="${-track_wheelbase/2} ${y_sign*(track_separation/2)} ${-ground_clearance}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="250.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <!-- Belt shell: visual representation spanning both sprockets. -->
    <link name="${side}_belt">
      <visual>
        <origin xyz="0 0 ${-ground_clearance}" rpy="0 0 0"/>
        <geometry><box size="${track_wheelbase} ${sprocket_width+belt_thickness} ${2*sprocket_radius}"/></geometry>
        <material name="matte_black"/>
      </visual>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${side}_belt_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_belt"/>
      <origin xyz="0 ${y_sign*(track_separation/2)} 0" rpy="0 0 0"/>
    </joint>

    <!-- Transmission for the driven (front) sprocket -->
    <xacro:if value="${driven}">
      <transmission name="${side}_front_trans">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="${side}_front_sprocket_joint">
          <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        </joint>
        <actuator name="${side}_front_motor">
          <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
          <mechanicalReduction>1</mechanicalReduction>
        </actuator>
      </transmission>
    </xacro:if>
  </xacro:macro>

  <xacro:track_side side="left"  y_sign="1"  driven="true"/>
  <xacro:track_side side="right" y_sign="-1" driven="true"/>

  <!-- ============================ ELECTRONICS ENCLOSURES ================= -->
  <!-- Main compute + motor driver box -->
  <link name="electronics_box">
    <visual>
      <geometry><box size="0.16 0.20 0.06"/></geometry>
      <material name="signal_yellow"/>
    </visual>
    <collision>
      <geometry><box size="0.16 0.20 0.06"/></geometry>
    </collision>
    <xacro:box_inertia mass="1.2" x="0.16" y="0.20" z="0.06"/>
  </link>
  <joint name="electronics_box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="electronics_box"/>
    <origin xyz="-0.08 0 ${chassis_height/2 + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- Battery pack -->
  <link name="battery_pack">
    <visual>
      <geometry><box size="0.18 0.10 0.06"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <geometry><box size="0.18 0.10 0.06"/></geometry>
    </collision>
    <xacro:box_inertia mass="1.8" x="0.18" y="0.10" z="0.06"/>
  </link>
  <joint name="battery_pack_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_pack"/>
    <origin xyz="0.10 0 ${chassis_height/2 + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ IMU ==================================== -->
  <link name="imu_link">
    <visual><geometry><box size="0.03 0.03 0.01"/></geometry><material name="signal_yellow"/></visual>
    <collision><geometry><box size="0.03 0.03 0.01"/></geometry></collision>
    <xacro:box_inertia mass="0.05" x="0.03" y="0.03" z="0.01"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_height/2 + 0.005}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ LIDAR MAST + SENSOR (SLAM) ============= -->
  <link name="lidar_mast">
    <visual>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height + 0.06}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height + 0.06}"/></geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.15" r="${mast_radius}" h="${mast_height + 0.06}"/>
  </link>
  <joint name="lidar_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mast"/>
    <origin xyz="-0.14 0 ${chassis_height/2 + (mast_height + 0.06)/2}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.2" r="0.035" h="0.04"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mast"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${(mast_height + 0.06)/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ ROVER-STYLE PAN-TILT CAMERA ============ -->
  <!-- Camera mast: taller, front-mounted, mimics a rover "mastcam" head -->
  <link name="camera_mast">
    <visual>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height*1.1}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height*1.1}"/></geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.15" r="${mast_radius}" h="${mast_height*1.1}"/>
  </link>
  <joint name="camera_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mast"/>
    <origin xyz="0.16 0 ${chassis_height/2 + (mast_height*1.1)/2}" rpy="0 0 0"/>
  </joint>

  <!-- Pan stage: continuous rotation about Z (full 360 deg coverage) -->
  <link name="camera_pan_link">
    <visual>
      <geometry><cylinder radius="0.025" length="0.02"/></geometry>
      <material name="signal_yellow"/>
    </visual>
    <collision><geometry><cylinder radius="0.025" length="0.02"/></geometry></collision>
    <xacro:cylinder_inertia mass="0.08" r="0.025" h="0.02"/>
  </link>
  <joint name="camera_pan_joint" type="revolute">
    <parent link="camera_mast"/>
    <child link="camera_pan_link"/>
    <origin xyz="0 0 ${(mast_height*1.1)/2 + 0.01}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="2.0" velocity="2.0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- Tilt stage: -60 (down) to +75 (up) deg, rover-style elevation range -->
  <link name="camera_tilt_link">
    <visual>
      <geometry><box size="0.03 0.06 0.03"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision><geometry><box size="0.03 0.06 0.03"/></geometry></collision>
    <xacro:box_inertia mass="0.1" x="0.03" y="0.06" z="0.03"/>
  </link>
  <joint name="camera_tilt_joint" type="revolute">
    <parent link="camera_pan_link"/>
    <child link="camera_tilt_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-60*PI/180}" upper="${75*PI/180}" effort="1.5" velocity="1.5"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- Camera optical body + lens -->
  <link name="camera_link">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="0.018" length="0.045"/></geometry>
      <material name="lens_glass"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 ${PI/2} 0"/>
      <geometry><cylinder radius="0.018" length="0.045"/></geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.06" r="0.018" h="0.045"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_tilt_link"/>
    <child link="camera_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame (REP-103: Z forward, X right, Y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.03 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- Pan/tilt transmissions -->
  <transmission name="camera_pan_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="camera_pan_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="camera_pan_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="camera_tilt_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="camera_tilt_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="camera_tilt_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ============================ GPS ANTENNA (outdoor UGV) ================ -->
  <link name="gps_link">
    <visual><geometry><cylinder radius="0.015" length="0.02"/></geometry><material name="signal_yellow"/></visual>
    <collision><geometry><cylinder radius="0.015" length="0.02"/></geometry></collision>
    <xacro:cylinder_inertia mass="0.03" r="0.015" h="0.02"/>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.14 0 ${chassis_height/2 + mast_height + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ GAZEBO HARMONIC SENSORS ================= -->
  <!-- 2D / 3D LiDAR for Mapping and Obstacle Avoidance -->
  <gazebo reference="lidar_link">
    <sensor type="gpu_lidar" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.35</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- Rover Pan-Tilt Head Camera -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="rover_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/image_raw</topic>
      <update_rate>30</update_rate>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera name="head">
        <horizontal_fov>1.4</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>150.0</far>
        </clip>
      </camera>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <pose>0 0 0 0 0 0</pose>
      <topic>/imu/data</topic>
      <update_rate>100</update_rate>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- GPS NavSat Sensor -->
  <gazebo reference="gps_link">
    <sensor type="navsat" name="gps_sensor">
      <pose>0 0 0 0 0 0</pose>
      <topic>/ugv/gps/fix</topic>
      <update_rate>5</update_rate>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ============================ GAZEBO HARMONIC MATERIALS & FRICTION == -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.15 0.15 0.15 1.0</diffuse>
        <specular>0.6 0.6 0.6 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="trim_strip">
    <visual>
      <material>
        <ambient>1.0 0.78 0.0 1.0</ambient>
        <diffuse>1.0 0.78 0.0 1.0</diffuse>
        <specular>0.8 0.8 0.8 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="electronics_box">
    <visual>
      <material>
        <ambient>1.0 0.78 0.0 1.0</ambient>
        <diffuse>1.0 0.78 0.0 1.0</diffuse>
        <specular>0.5 0.5 0.5 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="battery_pack">
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1.0</ambient>
        <diffuse>0.1 0.1 0.1 1.0</diffuse>
        <specular>0.4 0.4 0.4 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="lidar_mast">
    <visual>
      <material>
        <ambient>0.25 0.25 0.25 1.0</ambient>
        <diffuse>0.35 0.35 0.35 1.0</diffuse>
        <specular>0.7 0.7 0.7 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="lidar_link">
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1.0</ambient>
        <diffuse>0.1 0.1 0.1 1.0</diffuse>
        <specular>0.8 0.8 0.8 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="camera_link">
    <visual>
      <material>
        <ambient>0.1 0.1 0.1 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
        <specular>0.9 0.9 0.9 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="left_front_sprocket">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.3 0.3 0.3 1.0</diffuse>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="left_rear_sprocket">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.3 0.3 0.3 1.0</diffuse>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="right_front_sprocket">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.3 0.3 0.3 1.0</diffuse>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="right_rear_sprocket">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.3 0.3 0.3 1.0</diffuse>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="left_belt">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.03 0.03 0.03 1.0</ambient>
        <diffuse>0.08 0.08 0.08 1.0</diffuse>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="right_belt">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.03 0.03 0.03 1.0</ambient>
        <diffuse>0.08 0.08 0.08 1.0</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- ============================ GAZEBO HARMONIC SYSTEMS ================= -->
  <!-- 4-Sprocket Synchronous Belt Drive Mobility System -->
  <gazebo>
    <!-- Front Sprockets Drive -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_sprocket_joint</left_joint>
      <right_joint>right_front_sprocket_joint</right_joint>
      <wheel_separation>${track_separation}</wheel_separation>
      <wheel_radius>${sprocket_radius}</wheel_radius>
      <max_linear_acceleration>5.0</max_linear_acceleration>
      <max_angular_acceleration>6.0</max_angular_acceleration>
      <max_linear_velocity>3.0</max_linear_velocity>
      <min_linear_velocity>-3.0</min_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <min_angular_velocity>-4.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Rear Sprockets Drive -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_rear_sprocket_joint</left_joint>
      <right_joint>right_rear_sprocket_joint</right_joint>
      <wheel_separation>${track_separation}</wheel_separation>
      <wheel_radius>${sprocket_radius}</wheel_radius>
      <max_linear_acceleration>5.0</max_linear_acceleration>
      <max_angular_acceleration>6.0</max_angular_acceleration>
      <max_linear_velocity>3.0</max_linear_velocity>
      <min_linear_velocity>-3.0</min_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <min_angular_velocity>-4.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

</robot>
