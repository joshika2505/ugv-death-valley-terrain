<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ugv_terrain_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8066</gravity>

    <!-- Base ground: higher-friction gravel-like surface -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.45 0.42 0.35 1</ambient>
            <diffuse>0.55 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ramp #1: gentle incline, tests forward climb -->
    <model name="ramp_up">
      <static>true</static>
      <pose>2.0 0 0.15 0 -0.25 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 1.2 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.2 0.05</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Ramp #2: steeper decline, tests descent stability -->
    <model name="ramp_down">
      <static>true</static>
      <pose>-2.0 0 0.2 0 0.35 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 1.2 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.8 1.2 0.05</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Scattered rocks: tests skid-steer obstacle traversal -->
    <model name="rock_1">
      <static>true</static>
      <pose>0.5 1.0 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.08</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>0.25 0.2 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="rock_2">
      <static>true</static>
      <pose>0.9 -0.8 0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.06</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.25 0.2 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="rock_3">
      <static>true</static>
      <pose>-1.0 1.2 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.15 0.2</size></box></geometry>
          <material><ambient>0.28 0.24 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Trench/gap: tests belt bridging vs wheeled failure case -->
    <model name="trench_wall_a">
      <static>true</static>
      <pose>-0.3 -2.0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 1.5 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 1.5 0.2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>
    <model name="trench_wall_b">
      <static>true</static>
      <pose>0.15 -2.0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 1.5 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 1.5 0.2</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

  </world>
</sdf>
